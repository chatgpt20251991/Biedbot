test at tests\package.test.mjs:56:1
✖ Windows installer writes the path-bearing launcher in Unicode (1.8763ms)
  AssertionError [ERR_ASSERTION]: The input did not match the regular expression /Set-Content[^\n]*\$launcherPath[^\n]*-Encoding Unicode/. Input:
  
  '# Personal-user pilot bootstrap. No admin, no firewall changes, no AV exclusions.\n' +
    '# Not executed on Windows in this build environment; see docs/RELEASE_STATUS.md.\n' +
    'param([switch]$StartNow)\n' +
    "$ErrorActionPreference = 'Stop'\n" +
    '$packageRoot = Split-Path -Parent $PSScriptRoot\n' +
    "$version = (Get-Content (Join-Path $packageRoot 'package.json') -Raw | ConvertFrom-Json).version\n" +
    "if ($version -notmatch '^[a-zA-Z0-9.-]+$') { throw 'Ongeldige pakketversie.' }\n" +
    "$homeRoot = Join-Path $env:LOCALAPPDATA 'BiedBotEdgeApp'\n" +
    "$dataRoot = Join-Path $env:LOCALAPPDATA 'BiedBotEdge'\n" +
    "$versionRoot = Join-Path (Join-Path $homeRoot 'versions') $version\n" +
    "$runtimeRoot = Join-Path $homeRoot 'runtime'\n" +
    "$nodeExe = Join-Path $runtimeRoot 'node.exe'\n" +
    "Write-Host 'BiedBot Edge: demonstratie-installatie. Geen automatische afschrijving of echte verkopers.' -ForegroundColor Cyan\n" +
    "$lockFile = Join-Path $dataRoot 'app.lock'\n" +
    'if (Test-Path $lockFile) {\n' +
    '    $runningId = 0\n' +
    '    [void][int]::TryParse((Get-Content $lockFile -Raw), [ref]$runningId)\n' +
    '    if ($runningId -gt 0 -and (Get-Process -Id $runningId -ErrorAction SilentlyContinue)) {\n' +
    "        throw 'BiedBot draait nog. Sluit de agent af via Agent & controle voordat je installeert.'\n" +
    '    }\n' +
    '}\n' +
    '# SHA-256 detects corrupted/mismatched package files. This is NOT a publisher code signature.\n' +
    "$manifestFile = Join-Path $packageRoot 'MANIFEST.sha256.json'\n" +
    "if (-not (Test-Path $manifestFile)) { throw 'Integriteitsmanifest ontbreekt. Pak het volledige ZIP-bestand uit.' }\n" +
    '$manifest = Get-Content $manifestFile -Raw | ConvertFrom-Json\n' +
    'foreach ($entry in $manifest.files) {\n' +
    "    if ($entry.path -match '(^/|\\\\|\\.\\.)') { throw 'Ongeldig manifestpad.' }\n" +
    '    $path = Join-Path $packageRoot $entry.path\n' +
    '    if (-not (Test-Path -LiteralPath $path)) { throw "Bestand ontbreekt: $($entry.path)" }\n' +
    '    if ((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant() -ne $entry.sha256) { throw "Controle mislukt: $($entry.path)" }\n' +
    '}\n' +
